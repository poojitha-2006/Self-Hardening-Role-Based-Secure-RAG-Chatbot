# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Caching & environments
.pytest_cache/
.venv/
**/.venv/
env/
venv/
ENV/

# Sensitive files
.env
**/.env
*.pem
*.key

# Large raw & intermediate datasets (read-only raw and processed remain local)
**/data/raw/
dataset_pipeline/data/processed/

# Database & vector store runtime files (prevent OneDrive locking)
*.db
*.db-journal
*.db-wal
*.db-shm
**/chroma_db/

# Evaluation outputs
eval/results/
secure-rag/eval/results/
logs/
*.log
