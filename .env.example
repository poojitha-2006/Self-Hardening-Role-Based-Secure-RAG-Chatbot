# ============================================================
# Root Environment Configuration Template
# Copy this file to .env and customize as needed.
# DO NOT COMMIT SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ============================================================

# Chatbot Auth (JWT Secret)
AUTH_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# LLM Configuration (Ollama)
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0

# Embeddings Configuration
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Guardrail Mode: none | static | adaptive
GUARDRAIL_MODE=adaptive

# ChromaDB Storage
CHROMA_PERSIST_DIR=./data/chroma_db

# Logging
LOG_LEVEL=INFO

# Dataset Pipeline Configuration (Optional SEC EDGAR identity)
# SEC_USER_AGENT=YourOrganization contact@example.com
